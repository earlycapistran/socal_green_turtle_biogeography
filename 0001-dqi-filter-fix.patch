From 6e78517790feb80ef2afafa421b1323c00431642 Mon Sep 17 00:00:00 2001
From: "Claude (audit session)" <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 23:13:02 +0000
Subject: [PATCH] Fix data pipeline bug and adopt DQI filter for green turtle
 analysis

- 03_data_cleaning_historical.R: fix bug where num_turtles_numeric and
  weight_kg were computed into processed_data but never merged back
  into hist_data before saving. This made full_data_historical_round1
  (and everything downstream) unreproducible from the checked-in raw
  data; committed .rds outputs had apparently been generated by an
  earlier working version of this script.

- 05_green_data_wrangling.R: add data_quality_cat == 'high' filter to
  green_quant construction, adopting DQI-based screening as the final
  step of the modified PRISMA workflow described in Methods.

- 10_sightings_dataviz.R: add the same DQI filter ahead of the
  north/south dotplot comparison; fix an unrelated theme() bug
  (bare element_text() where text = element_text() was intended,
  which crashed on current ggplot2); add ggsave() so the figure is
  actually written to plots/sightings_dotplot.png instead of only
  rendering interactively.

Effect on reported statistics (green turtles, high-quality records
with reported abundance, north vs. south of SoCal Bight):
  n: 32/43 -> 31/34
  median (south): 57.5 -> 57.5 (unchanged)
  IQR (south): 4.5-115 -> 2.25-115
  Kruskal-Wallis H: 32.801 -> 28.304, p < 0.001 (both cases)
Core finding (higher abundance south of the Bight) is unchanged.

Regenerated all downstream processed data files accordingly.
---
 R/03_data_cleaning_historical.R               |   4 +
 R/05_green_data_wrangling.R                   |   3 +-
 R/10_sightings_dataviz.R                      |   8 +-
 data/processed/full_data_green.rds            | Bin 46498 -> 46538 bytes
 .../full_data_historical_locations.csv        | 296 +++++++++---------
 .../full_data_historical_locations.rds        | Bin 80465 -> 80412 bytes
 data/processed/full_data_historical_round1    | 290 ++++++++---------
 .../processed/full_data_historical_round1.rds | Bin 84579 -> 85131 bytes
 data/processed/green_means.rds                | Bin 1605 -> 1523 bytes
 .../processed/green_means_full_chronology.csv |  21 +-
 .../processed/green_means_full_chronology.rds | Bin 1439 -> 1409 bytes
 data/processed/green_quant.rds                | Bin 1786 -> 1612 bytes
 data/processed/historical_dqi.rds             | Bin 84176 -> 84191 bytes
 data/raw/clean_historical_data.rds            | Bin 83946 -> 83960 bytes
 plots/sightings_dotplot.png                   | Bin 0 -> 77325 bytes
 15 files changed, 315 insertions(+), 307 deletions(-)
 create mode 100644 plots/sightings_dotplot.png

diff --git a/R/03_data_cleaning_historical.R b/R/03_data_cleaning_historical.R
index 08edc53..5b6a3f7 100644
--- a/R/03_data_cleaning_historical.R
+++ b/R/03_data_cleaning_historical.R
@@ -58,8 +58,12 @@ length_df <- processed_data %>% # Wrangle length to cm in a separate dataframe
   mutate(length_cm = ifelse(length_cm == 0, NA, length_cm)) # remove placeholder 0s
 
 # Add to the main dataframe
+# FIX: previously only length_cm was copied back from processed_data,
+# silently dropping num_turtles_numeric and weight_kg. Restored below.
 hist_data <- hist_data %>% 
   mutate(length_cm = length_df$length_cm) %>%
+  mutate(num_turtles_numeric = processed_data$num_turtles_numeric) %>%
+  mutate(weight_kg = processed_data$weight_kg) %>%
   mutate(length_ft_inches = ifelse(length_ft_inches == "0'0", 
                                    NA, 
                                    length_ft_inches)) # Remove placeholder 0s
diff --git a/R/05_green_data_wrangling.R b/R/05_green_data_wrangling.R
index 68d19d9..44caf2e 100644
--- a/R/05_green_data_wrangling.R
+++ b/R/05_green_data_wrangling.R
@@ -48,7 +48,8 @@ green_quant <- green_data %>%
   filter(location != "na") %>% 
   filter(county_muni != "na") %>% 
   filter(year < 1940) %>%  # Limit to commercial fishing years 
-  filter(latitude < 35) # Remove values north of SoCal Bight
+  filter(latitude < 35) %>%  # Remove values north of SoCal Bight
+  filter(data_quality_cat == "high") # Retain only high-quality records (modified PRISMA / DQI screening)
 
 # Save
 saveRDS(green_quant, "./data/processed/green_quant.rds")
diff --git a/R/10_sightings_dataviz.R b/R/10_sightings_dataviz.R
index 0e5fb71..786a92e 100644
--- a/R/10_sightings_dataviz.R
+++ b/R/10_sightings_dataviz.R
@@ -2,10 +2,11 @@ data <- readRDS("./data/processed/full_data_green.rds")
 library(tidyverse)
 
 plot_data <- data %>% 
+  filter(data_quality_cat == "high") %>%  # DQI filter: retain only high-quality records
   select(num_turtles_numeric, lat_group) %>% 
   na.omit()
 
-ggplot(plot_data, aes(x = num_turtles_numeric, y = lat_group, fill = lat_group)) +
+p <- ggplot(plot_data, aes(x = num_turtles_numeric, y = lat_group, fill = lat_group)) +
   geom_dotplot(binaxis = "x",           # CHANGED from "y"
                stackdir = "up",
                dotsize = 2.25,
@@ -31,10 +32,13 @@ ggplot(plot_data, aes(x = num_turtles_numeric, y = lat_group, fill = lat_group))
   theme_classic(base_size = 14) +
   theme(
     # Font
-    element_text(family = "Lato"),
+    text = element_text(family = "Lato"),
     legend.position = "none",
     axis.title = element_text(face = "bold"),
     panel.grid.major.x = element_line(color = "gray90", size = 0.3),
     strip.background = element_blank(),  # removes facet background
     strip.text = element_blank()         # removes facet text
   )
+
+p
+ggsave("./plots/sightings_dotplot.png", plot = p, width = 8, height = 5, dpi = 300)
